<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <RootNamespace>Tavstal.BeaconSDK</RootNamespace>
        <AssemblyName>BeaconSDK</AssemblyName>
        <AssemblyTitle>BeaconSDK</AssemblyTitle>
        <Product>BeaconSDK</Product>
        <Description>A .NET library for building Minecraft launchers. Handles Microsoft authentication, game file installation, Fabric/Quilt/Forge/NeoForge mod loaders, Java runtime management and launching the game.</Description>
        <Company>Tavstal</Company>
        <Authors>Tavstal</Authors>
        <Copyright>Copyright © 2026 Tavstal</Copyright>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
        <Version>1.0.0</Version>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

        <PackageTags>api sdk client minecraft minecraft-launcher fabric forge neoforge quilt</PackageTags>
        <PackageProjectUrl>https://github.com/TavstalDev/BeaconSDK</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/TavstalDev/BeaconSDK/releases</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/TavstalDev/BeaconSDK</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DebugType>portable</DebugType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.13" />
        <PackageReference Include="NbtLib" Version="1.0.1"/>
        <PackageReference Include="SharpZipLib" Version="1.4.2"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    </ItemGroup>
</Project>
